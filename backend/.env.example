PORT=5080
NODE_ENV=production

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ventas_crm

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=8h

# Frontend allowed origins
FRONTEND_URL=https://tu-frontend.vercel.app
CORS_ORIGINS=https://tu-frontend.vercel.app

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# n8n / Asistente CRM por WhatsApp (solo lectura)
CRM_ASSISTANT_AUTOMATION_KEY=replace_with_a_separate_long_random_secret
CRM_ASSISTANT_TENANT_ID=1

# PUCHI / Cerebro personal (lectura y escritura, usar una clave exclusiva)
PUCHI_AUTOMATION_KEY=replace_with_a_separate_long_random_secret
PUCHI_TENANT_ID=1
